				DropdownLabel.TextColor3 = Colors.Text
				DropdownLabel.TextSize = 14
				DropdownLabel.TextXAlignment = Enum.TextXAlignment.Left
				DropdownLabel.Parent = DropdownFrame
				
				local DropdownButton = Instance.new("TextButton")
				DropdownButton.Position = UDim2.new(1, -35, 0, 5)
				DropdownButton.Size = UDim2.new(0, 30, 0, 30)
				DropdownButton.BackgroundColor3 = Colors.Glass
				DropdownButton.BorderSizePixel = 0
				DropdownButton.Font = Enum.Font.GothamBold
				DropdownButton.Text = "▼"
				DropdownButton.TextColor3 = Colors.Accent
				DropdownButton.TextSize = 12
				DropdownButton.Parent = DropdownFrame
				CreateCorner(DropdownButton, 6)
				
				local OptionsList = Instance.new("Frame")
				OptionsList.Position = UDim2.new(0, 0, 0, 45)
				OptionsList.Size = UDim2.new(1, 0, 0, 0)
				OptionsList.BackgroundTransparency = 1
				OptionsList.AutomaticSize = Enum.AutomaticSize.Y
				OptionsList.Visible = false
				OptionsList.Parent = DropdownFrame
				
				local OptionsLayout = Instance.new("UIListLayout")
				OptionsLayout.Padding = UDim.new(0, 5)
				OptionsLayout.Parent = OptionsList
				
				local expanded = false
				
				DropdownButton.MouseButton1Click:Connect(function()
					expanded = not expanded
					OptionsList.Visible = expanded
					
					SmoothTween(DropdownFrame, {
						Size = expanded and UDim2.new(1, 0, 0, 50 + #options * 35) or UDim2.new(1, 0, 0, 40)
					}, 0.3, Enum.EasingStyle.Back)
					
					SmoothTween(DropdownButton, {
						Rotation = expanded and 180 or 0
					}, 0.3)
				end)
				
				for _, option in ipairs(options) do
					local OptionButton = Instance.new("TextButton")
					OptionButton.Size = UDim2.new(1, -24, 0, 30)
					OptionButton.Position = UDim2.new(0, 12, 0, 0)
					OptionButton.BackgroundColor3 = Colors.Glass
					OptionButton.BackgroundTransparency = 0.5
					OptionButton.BorderSizePixel = 0
					OptionButton.Font = Enum.Font.Gotham
					OptionButton.Text = option
					OptionButton.TextColor3 = Colors.Text
					OptionButton.TextSize = 13
					OptionButton.Parent = OptionsList
					CreateCorner(OptionButton, 6)
					
					OptionButton.MouseEnter:Connect(function()
						SmoothTween(OptionButton, {BackgroundColor3 = Colors.Accent, BackgroundTransparency = 0.3}, 0.2)
					end)
					
					OptionButton.MouseLeave:Connect(function()
						SmoothTween(OptionButton, {BackgroundColor3 = Colors.Glass, BackgroundTransparency = 0.5}, 0.2)
					end)
					
					OptionButton.MouseButton1Click:Connect(function()
						pcall(callback, option)
						expanded = false
						OptionsList.Visible = false
						SmoothTween(DropdownFrame, {Size = UDim2.new(1, 0, 0, 40)}, 0.3)
						SmoothTween(DropdownButton, {Rotation = 0}, 0.3)
					end)
				end
				
				return DropdownFrame
			end
			
			return Section
		end
		
		return Page
	end
	
	-- Entrance animation
	MainFrame.Size = UDim2.new(0, 0, 0, 0)
	SmoothTween(MainFrame, {Size = UDim2.new(0, 700, 0, 500)}, 0.5, Enum.EasingStyle.Back)
	
	return GUI
end

